---
const { class: className, id, ...rest } = Astro.props;
---

<h2 id={id} class:list={['section-title', className]} {...rest}>
    <slot />
</h2>

<style>
    .section-title {
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
        margin-bottom: var(--spacing-xl);
        font-family: var(--font-primary);
        font-size: var(--text-body-lg);
        line-height: var(--text-heading-lg-lh);
        letter-spacing: var(--text-heading-lg-ls);
        font-weight: 600;
        color: var(--color-ink);
    }

    .section-title::before {
        content: "//";
        color: var(--color-mute);
        font-family: var(--font-mono);
        font-weight: 400;
        font-size: 0.8em;
    }
</style>