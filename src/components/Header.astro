---
import ThemeToggle from "@/components/ThemeToggle.astro"

const navItems = [
    {
        title: "Proyectos",
        label: "projects",
        url: "/#projects",
    },
    {
        title: "Experiencia",
        label: "experience",
        url: "/#experience",
    },
    {
        title: "Formación",
        label: "education",
        url: "/#education",
    },
    {
        title: "Sobre mí",
        label: "about-me",
        url: "/#about-me",
    },
]
---

<header class="header">
    <div class="header__inner">
        <a class="header__brand" href="/" aria-label="Inicio">
            <img src="/profile.webp" alt="Mario Llesta" class="header__avatar" width="32" height="32" />
        </a>

        <nav class="header__nav">
            {
                navItems.map((link) => (
                    <a
                        class="header__nav-link"
                        aria-label={link.label}
                        href={link.url}
                    >
                        {link.title}
                    </a>
                ))
            }
        </nav>

        <div class="header__theme">
            <ThemeToggle />
        </div>
    </div>
</header>

<script>
    document.addEventListener("astro:page-load", () => {
        const sections = document.querySelectorAll("section")
        const navItems = document.querySelectorAll(".header__nav-link")

        const callback = (entries: any[]) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    navItems.forEach((item) => {
                        const isCurrent =
                            item.getAttribute("aria-label") == entry.target.id
                        item.classList.toggle("is-active", isCurrent)
                        if (isCurrent) {
                            item.setAttribute("aria-current", "location")
                        } else {
                            item.removeAttribute("aria-current")
                        }
                    })
                }
            })
        }

        const observer = new IntersectionObserver(callback, {
            root: null,
            rootMargin: "0px",
            threshold: 0.3,
        })

        sections.forEach((section) => {
            observer.observe(section)
        })

        document.onvisibilitychange = () => {
            if (document.visibilityState === "hidden") {
                observer.disconnect()
            } else {
                sections.forEach((section) => {
                    observer.observe(section)
                })
            }
        }
    })
</script>

<style>
    .header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        background-color: var(--color-canvas);
        border-bottom: 1px solid var(--color-hairline);
    }

    .header__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: var(--layout-max-width);
        height: 64px;
        margin-inline: auto;
        padding-inline: var(--layout-page-padding);
        gap: var(--spacing-md);
    }

    .header__brand {
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border-radius: var(--radius-pill);
    }

    .header__brand:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 4px;
    }

    .header__avatar {
        width: 36px;
        height: 36px;
        border-radius: var(--radius-pill);
        object-fit: cover;
        border: 1px solid var(--color-hairline);
        transition: border-color 0.15s ease;
    }

    .header__brand:hover .header__avatar {
        border-color: var(--color-mute);
    }

    .header__nav {
        display: none;
        align-items: center;
        gap: var(--spacing-xs);
    }

    @media (min-width: 768px) {
        .header__nav {
            display: flex;
        }
    }

    .header__nav-link {
        font-family: var(--font-primary);
        font-size: var(--text-body-sm);
        line-height: var(--text-body-sm-lh);
        font-weight: 500;
        color: var(--color-body);
        text-decoration: none;
        padding: 8px var(--spacing-sm);
        border-radius: var(--radius-sm);
        transition: color 0.15s ease;
    }

    .header__nav-link:hover {
        color: var(--color-ink);
    }

    .header__nav-link.is-active {
        color: var(--color-accent);
        text-decoration: underline;
        text-decoration-color: var(--color-accent);
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
    }

    .header__nav-link:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
    }

    .header__theme {
        display: flex;
        align-items: center;
    }
</style>