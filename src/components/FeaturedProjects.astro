---
import Link from "@/components/icons/Link.astro";
import LinkButton from "@/components/LinkButton.astro";

import GitHub from "@/components/icons/GitHub.astro";
import TypeScript from "@/components/icons/TypeScript.astro";
import JavaScript from "@/components/icons/JavaScript.astro";
import React from "@/components/icons/React.astro";
import CSS from "@/components/icons/CSS.astro";
import Tailwind from "@/components/icons/Tailwind.astro";
import FastApi from "@/components/icons/FastApi.astro";
import Vercel from "@/components/icons/Vercel.astro";
import VSCode from "@/components/icons/VSCode.astro";

const TAGS = {
    TYPESCRIPT: { name: "TypeScript", icon: TypeScript },
    JAVASCRIPT: { name: "JavaScript", icon: JavaScript },
    REACT: { name: "React", icon: React },
    CSS: { name: "CSS", icon: CSS },
    TAILWIND: { name: "Tailwind", icon: Tailwind },
    FASTAPI: { name: "FastAPI", icon: FastApi },
    VERCEL: { name: "Vercel", icon: Vercel },
    VSCODE: { name: "VSCode", icon: VSCode },
};

const PROJECTS = [
    {
        title: "Wins",
        description: "Lista de tareas diarias minimalista.",
        link: "https://winsapp.vercel.app/",
        github: "https://github.com/mariollesta/wins",
        image: "/projects/wins.webp",
        tags: [TAGS.JAVASCRIPT, TAGS.REACT, TAGS.CSS, TAGS.VERCEL],
    },
];
---

<div class="projects">
    {
        PROJECTS.map(({ image, title, description, tags, link, github }) => (
            <article class="project">
                <div class="project__image">
                    <img alt="" loading="lazy" src={image} />
                </div>

                <div class="project__info">
                    <h3 class="project__title">{title}</h3>

                    <ul class="project__tags">
                        {tags.map((tag) => (
                            <li>
                                <span class="project__tag">
                                    <tag.icon />
                                    {tag.name}
                                </span>
                            </li>
                        ))}
                    </ul>

                    <p class="project__description">{description}</p>

                    <div class="project__actions">
                        {github && (
                            <LinkButton href={github}>
                                <GitHub />
                                Code
                            </LinkButton>
                        )}
                        {link && (
                            <LinkButton href={link}>
                                <Link />
                                Preview
                            </LinkButton>
                        )}
                    </div>
                </div>
            </article>
        ))
    }
</div>

<style>
    .projects {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-3xl);
    }

    .project {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--spacing-lg);
    }

    @media (min-width: 768px) {
        .project {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: var(--spacing-2xl);
            align-items: start;
        }
    }

    .project__image {
        width: 100%;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-lg);
        transition: border-color 0.2s ease;
    }

    .project__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        display: block;
        transition: transform 0.3s ease;
    }

    .project__image:hover {
        border-color: var(--color-primary);
    }

    .project__image:hover img {
        transform: scale(1.02);
    }

    .project__info {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }

    @media (min-width: 768px) {
        .project__info {
            padding-top: var(--spacing-xs);
        }
    }

    .project__title {
        font-family: var(--font-primary);
        font-weight: 600;
        font-size: var(--text-heading-md);
        line-height: var(--text-heading-md-lh);
        letter-spacing: var(--text-heading-md-ls);
        color: var(--color-ink);
        margin: 0;
    }

    .project__tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-xs);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .project__tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-mono);
        font-size: var(--text-caption);
        line-height: 1;
        color: var(--color-mute);
        background-color: var(--color-canvas-soft);
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-pill);
        padding: 4px 10px;
    }

    .project__tag svg {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
    }

    /* Description: body-md */
    .project__description {
        font-family: var(--font-primary);
        font-size: var(--text-body-md);
        line-height: var(--text-body-md-lh);
        color: var(--color-body);
        margin: 0;
        text-wrap: pretty;
    }

    .project__actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
        margin-top: var(--spacing-xs);
    }

    .project__actions svg {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
    }
</style>
