<div class="hero">
    <h1 class="hero__name">MARIO LLESTA</h1>

    <p class="hero__description">
        Ingeniero de Telecomunicaciones. Actualmente estudiando el Máster en Ciencia de Datos.
    </p>

    <div class="hero__social">
        <a href="https://github.com/mariollesta" class="hero__social-link" target="_blank" rel="noopener noreferrer">github</a>
        <span class="hero__social-sep" aria-hidden="true">·</span>
        <a href="https://www.linkedin.com/in/mariollesta/" class="hero__social-link" target="_blank" rel="noopener noreferrer">linkedin</a>
        <span class="hero__social-sep" aria-hidden="true">·</span>
        <a href="https://x.com/mariollesta" class="hero__social-link" target="_blank" rel="noopener noreferrer">X</a>
    </div>
</div>

<style>
    :root {
        --hero-right-effect-opacity: 0.2;
    }

    .hero {
        position: relative;
        max-width: 900px;
        margin-inline: auto;
        padding: var(--spacing-2xl) 0;
    }

    .hero__name {
        font-family: var(--font-primary);
        font-weight: 700;
        color: var(--color-ink);
        font-size: 40px;
        line-height: 1.05;
        letter-spacing: -0.04em;
        margin: 0 0 var(--spacing-xl);
    }

    @media (min-width: 480px) {
        .hero__name {
            font-size: 48px;
        }
    }

    @media (min-width: 768px) {
        .hero__name {
            font-size: 56px;
        }
    }

    @media (min-width: 1024px) {
        .hero__name {
            font-size: var(--text-display-xl);
            line-height: var(--text-display-xl-lh);
            letter-spacing: var(--text-display-xl-ls);
        }
    }

    .hero__description {
        font-family: var(--font-primary);
        font-size: 16px;
        line-height: var(--text-body-md-lh);
        color: var(--color-body);
        margin: 0 0 var(--spacing-2xl);
        max-width: 600px;
        text-wrap: pretty;
    }

    @media (min-width: 768px) {
        .hero__description {
            font-size: var(--text-body-lg);
            line-height: var(--text-body-lg-lh);
        }
    }

    .hero__social {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        font-family: var(--font-mono);
        font-size: 13px;
        line-height: 1;
    }

    .hero__social-link {
        color: var(--color-mute);
        text-decoration: none;
        transition: color 0.15s ease;
    }

    .hero__social-link:hover {
        color: var(--color-accent);
    }

    .hero__social-sep {
        color: var(--color-hairline);
        user-select: none;
    }

    @media (prefers-reduced-motion: no-preference) {
        .hero {
            animation: hero-fade-in 0.5s ease-out both;
        }

        @keyframes hero-fade-in {
            from {
                opacity: 0;
                transform: translateY(4px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    }

</style>