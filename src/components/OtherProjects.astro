---
import LinkButton from "@/components/LinkButton.astro";

import GitHub from "@/components/icons/GitHub.astro";
import Link from "@/components/icons/Link.astro";

const OTHER_PROJECTS = [
    {
        title: "country explorer",
        description: "Aplicación web minimalista para explorar información sobre países de todo el mundo.",
        github: "https://github.com/mariollesta/country-explorer",
        link: "https://country-explorer.vercel.app/",
    },
    {
        title: "loadingVI",
        description:
        "Contador en tiempo real de la fecha de lanzamiento de Grand Theft Auto VI.",
        github: "https://github.com/mariollesta/loadingVI",
        link: "https://loadingvi.com",
    },
    {
        title: "cli-wordcount",
        description: "Mi propia versión de la herramienta de línea de comandos de Unix «wc».",
        github: "https://github.com/mariollesta/cli-wordcount",
    },

];
---

<div class="other-projects">
    <div
        id="other-slider"
        class="other-projects__carousel"
    >
        {
            OTHER_PROJECTS.map(({ title, description, github, link }) => (
                <article class="other-projects__card">
                    <h3 class="other-projects__card-title">{title}</h3>
                    <p class="other-projects__card-description">{description}</p>
                    <footer class="other-projects__card-actions">
                        {github && (
                            <LinkButton href={github}>
                                <GitHub />
                                Code
                            </LinkButton>
                        )}
                        {link && (
                            <LinkButton href={link}>
                                <Link />
                                Preview
                            </LinkButton>
                        )}
                    </footer>
                </article>
            ))
        }
    </div>

    {
        OTHER_PROJECTS.length > 1 && (
            <div class="other-projects__controls">
                <button
                    id="prev-btn"
                    aria-label="Previous"
                    class="other-projects__btn"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M15 18l-6-6 6-6" />
                    </svg>
                </button>
                <button
                    id="next-btn"
                    aria-label="Next"
                    class="other-projects__btn"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M9 18l6-6-6-6" />
                    </svg>
                </button>
            </div>
        )
    }
</div>

<style>
    .other-projects {
        position: relative;
    }

    /* Carousel track */
    .other-projects__carousel {
        display: flex;
        gap: var(--spacing-lg);
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        padding-bottom: var(--spacing-md);
        scrollbar-width: none;
    }

    .other-projects__carousel::-webkit-scrollbar {
        display: none;
    }

    /* Project card */
    .other-projects__card {
        flex: 0 0 85%;
        min-width: 280px;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
        padding: var(--spacing-lg);
        background-color: var(--color-canvas);
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-lg);
        scroll-snap-align: start;
        transition: border-color 0.2s ease;
    }

    @media (min-width: 768px) {
        .other-projects__card {
            flex: 0 0 calc((100% - 2 * var(--spacing-lg)) / 3);
        }
    }

    .other-projects__card:hover {
        border-color: var(--color-accent);
    }

    .other-projects__card-title {
        font-family: var(--font-primary);
        font-weight: 600;
        font-size: var(--text-body-lg);
        line-height: var(--text-body-lg-lh);
        color: var(--color-ink);
        margin: 0;
    }

    .other-projects__card-description {
        font-family: var(--font-primary);
        font-size: var(--text-body-md);
        line-height: var(--text-body-md-lh);
        color: var(--color-body);
        margin: 0;
        flex: 1;
    }

    .other-projects__card-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
        margin-top: var(--spacing-sm);
    }

    /* Carousel controls */
    .other-projects__controls {
        display: flex;
        justify-content: flex-end;
        gap: var(--spacing-sm);
        margin-top: var(--spacing-md);
    }

    .other-projects__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background-color: var(--color-canvas);
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-sm);
        color: var(--color-ink);
        cursor: pointer;
        padding: 0;
        transition:
            border-color 0.15s ease,
            color 0.15s ease;
    }

    .other-projects__btn:hover:not(:disabled) {
        border-color: var(--color-ink);
        color: var(--color-accent);
    }

    .other-projects__btn:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
    }

    .other-projects__btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
</style>

<script>
    const slider = document.getElementById("other-slider") as HTMLElement;
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");

    const scrollByCard = () => {
        const card = slider.querySelector("article") as HTMLElement;
        // Card width + gap (--spacing-lg = 24px)
        return card ? card.offsetWidth + 24 : 280;
    };

    prevBtn?.addEventListener("click", () => {
        slider.scrollBy({ left: -scrollByCard(), behavior: "smooth" });
    });

    nextBtn?.addEventListener("click", () => {
        slider.scrollBy({ left: scrollByCard(), behavior: "smooth" });
    });
</script>
