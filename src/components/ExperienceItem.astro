---
interface Props {
    title: string;
    company: string;
    date: string;
    description: string;
}

const { title, company, date, description } = Astro.props;

const isCurrent = date.toLowerCase().includes("actual");
---

<div class:list={["experience-item", { "experience-item--current": isCurrent }]}>
    <span class="experience-item__marker" aria-hidden="true"></span>

    <div class="experience-item__grid">
        <div class="experience-item__meta">
            <time class="experience-item__date">{date}</time>
            <h3 class="experience-item__title">{title}</h3>
            <p class="experience-item__company">{company}</p>
        </div>

        <div class="experience-item__description">{description}</div>
    </div>
</div>

<style>
    .experience-item {
        position: relative;
        padding-left: var(--spacing-lg);
        padding-bottom: var(--spacing-2xl);
    }

    .experience-item::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 1px;
        background-color: var(--color-hairline);
    }

    .experience-item__marker {
        position: absolute;
        left: 0;
        top: 8px;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: var(--color-mute);
        transform: translateX(-50%);
    }

    .experience-item--current .experience-item__marker {
        background-color: var(--color-primary);
    }

    .experience-item__grid {
        display: grid;
        gap: var(--spacing-xs);
    }

    @media (min-width: 768px) {
        .experience-item__grid {
            grid-template-columns: 2fr 3fr;
            gap: var(--spacing-xl);
        }
    }

    /* Meta column: title / company / date, tightly stacked */
    .experience-item__meta {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .experience-item__title {
        font-family: var(--font-primary);
        font-weight: 600;
        font-size: var(--text-body-md);
        line-height: var(--text-body-sm-lh);
        color: var(--color-ink);
        margin: 0;
    }

    .experience-item__company {
        font-family: var(--font-primary);
        font-size: var(--text-body-md);
        color: var(--color-mute);
        margin: 0;
    }

    .experience-item__date {
        font-family: var(--font-mono);
        font-size: var(--text-caption);
        line-height: var(--text-body-md-lh);
        color: var(--color-mute);
        margin: 0;
    }

    .experience-item__description {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
        font-family: var(--font-primary);
        font-size: var(--text-body-md);
        line-height: var(--text-body-md-lh);
        color: var(--color-body);
        margin: 0;
        text-wrap: pretty;
    }
    
    :global(li:last-child) .experience-item {
        padding-bottom: 0;
    }
</style>
