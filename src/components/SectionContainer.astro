---
const { class: className, id } = Astro.props;
---

<section
    id={id}
    data-section={id}
    class:list={["section", className]}
>
    <slot />
</section>

<style>
    .section {
        box-sizing: border-box;
        width: 100%;
        max-width: var(--layout-reading-width);
        margin-inline: auto;
        padding-inline: var(--layout-page-padding);
        padding-block: var(--spacing-2xl);
        scroll-margin-top: var(--layout-header-offset);
    }

    .section[data-section="hero"] {
        padding-block: var(--spacing-3xl);
    }

    @media (min-width: 768px) {
        .section {
            padding-block: var(--spacing-3xl);
        }
        .section[data-section="hero"] {
            padding-block: var(--spacing-4xl);
        }
    }
</style>
