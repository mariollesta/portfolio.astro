---
import BaseLayout from "@/layouts/BaseLayout.astro"

import SectionContainer from "@/components/SectionContainer.astro"
import SectionTitle from "@/components/SectionTitle.astro"
import Hero from "@/components/Hero.astro"
import Experience from "@/components/Experience.astro"
import FeaturedProjects from "@/components/FeaturedProjects.astro"
import OtherProjects from "@/components/OtherProjects.astro"
import Education from "@/components/Education.astro"
import AboutMe from "@/components/AboutMe.astro"
---

<BaseLayout 
	pageTitle="Mario @mariollesta" 
	description="Portfolio personal de mariollesta, desarrollador web con experiencia en tecnologías modernas."
>
	<main>
		<SectionContainer id="hero">
			<Hero />
		</SectionContainer>

		<SectionContainer id="projects">
			<SectionTitle>Featured</SectionTitle>
			<FeaturedProjects />
		</SectionContainer>
		
		<SectionContainer id="other-projects">
			<SectionTitle>Other Works</SectionTitle>
			<OtherProjects />
		</SectionContainer>

		<SectionContainer id="experience">
			<SectionTitle>Experience</SectionTitle>
			<Experience />
		</SectionContainer>

		<SectionContainer id="education">
			<SectionTitle>Education</SectionTitle>
			<Education />
		</SectionContainer>

		<SectionContainer id="about-me">
			<SectionTitle>About Me</SectionTitle>
			<AboutMe />
		</SectionContainer>
	</main>
</BaseLayout>
